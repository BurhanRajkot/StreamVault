# Backend-only localhost template
# Optional if you prefer storing backend env in backend/.env
# (project root .env.local also works)

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:8080

DATABASE_URL=your_database_url_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_AUDIENCE=your_auth0_audience_here
AUTH0_ISSUER_BASE_URL=https://your-auth0-domain.auth0.com/

TMDB_API_KEY=your_tmdb_api_key_here

# Real-Debrid API key — get it from https://real-debrid.com/apitoken
DEBRID_API_KEY=your_real_debrid_api_token_here

# Optional. Torrentio is given the Real-Debrid key so it can tag which
# releases are cached ("[RD+]") — Real-Debrid has no cache-check endpoint of
# its own any more. Set to false to keep the key away from Torrentio (every
# release then shows as uncached until it's tried).
# TORRENTIO_DEBRID_CACHE=true
# Optional. Real-Debrid refuses most datacenter IPs (error 22, "IP Address
# not allowed"), so a hosted backend (Render, VPS) may need to send its
# Real-Debrid calls through a proxy Real-Debrid accepts — e.g. a residential
# or whitelisted VPN proxy: http://user:pass@host:port
# DEBRID_PROXY_URL=
# Audio language(s) Real-Debrid's HLS transcode should prefer, ISO 639 codes.
# DEBRID_PREFERRED_AUDIO_LANGS=eng,en

# TOTP secret for admin login (scan a QR code into an authenticator app instead
# of typing a code by hand). Generate one with: bun scripts/setup-admin-totp.ts
ADMIN_TOTP_SECRET=your_admin_totp_secret
ADMIN_JWT_SECRET=your_admin_jwt_secret

UPI_ID=your_upi_id
UPI_PAYEE_NAME=StreamVault
UPI_PHONE_NUMBER=your_upi_phone_number

# Optional
# REDIS_URL=redis://localhost:6379
# OPENAI_API_KEY=sk-...
