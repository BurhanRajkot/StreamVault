{
  "name": "streamvault-app",
  "productName": "StreamVault",
  "private": true,
  "version": "1.0.0",
  "description": "StreamVault for Android and Linux",
  "author": {
    "name": "Piracy Is Not Stealing",
    "email": "183266853+dragon-manner@users.noreply.github.com"
  },
  "homepage": "https://stream-vault.site",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:open": "cap open android",
    "linux:dev": "npm run build && electron .",
    "linux:build": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "selfsigned": "5.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "license": "UNLICENSED"
}
