{
  "name": "streamvault-app",
  "productName": "StreamVault",
  "private": true,
  "version": "1.0.0",
  "description": "StreamVault for Android, Linux and Windows",
  "author": {
    "name": "Burhanuddin Rajkotwala",
    "email": "BurhanRajkot@users.noreply.github.com"
  },
  "homepage": "https://stream-vault.site",
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "streamvault.desktop",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test electron/*.test.cjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:open": "cap open android",
    "linux:dev": "npm run build && electron .",
    "linux:build": "npm run build && electron-builder --linux --publish never",
    "windows:build": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "selfsigned": "5.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/manrope": "5.2.8",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "ffmpeg-static": "5.3.0"
  },
  "license": "UNLICENSED",
  "overrides": {
    "minimatch@^9.0.0 || ^10.0.0": "^11.0.1"
  }
}
