{
  "name": "streamvault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" --names \"frontend,backend\" --prefix-colors \"cyan,magenta\"",
    "dev:frontend": "vite",
    "dev:backend": "cd backend && bun --watch src/index.ts",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "bun test ./src",
    "test:backend": "cd backend && bun test",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke --project=desktop",
    "e2e:all-browsers": "E2E_ALL_BROWSERS=1 playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report e2e/playwright-report",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "gen:csp": "bun run scripts/gen-csp.ts"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.28.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.24",
    "@vercel/analytics": "^2.0.1",
    "baseline-browser-mapping": "^2.11.8",
    "body-parser": "^2.3.0",
    "caniuse-lite": "^1.0.30001800",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.3.0",
    "framer-motion": "^13.2.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.70.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^2.0.5",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@ghostery/adblocker-playwright": "^2.20.1",
    "@happy-dom/global-registrator": "^20.10.6",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/testing-library__react": "^10.2.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "concurrently": "^10.0.6",
    "cross-fetch": "^4.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.15.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.2",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "picomatch": ">=4.0.2",
    "path-to-regexp": ">=8.0.0",
    "minimatch": ">=9.0.5",
    "brace-expansion": ">=2.0.1",
    "ws": ">=8.17.1",
    "qs": ">=6.11.0",
    "flatted": ">=3.3.3",
    "express-rate-limit": ">=7.5.0",
    "ip-address": ">=9.0.5",
    "uuid": ">=10.0.0",
    "diff": ">=5.2.0"
  }
}
