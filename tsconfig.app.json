{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    // `strict` is on, matching what CLAUDE.md documents. strictNullChecks and
    // noImplicitAny are the two the existing code does not satisfy yet; they
    // are opted out individually so the rest of strict (strictBindCallApply,
    // strictFunctionTypes, noImplicitThis, useUnknownInCatchVariables, …) is
    // enforced now rather than blocked behind one big migration. Flip these two
    // off-switches away as the codebase is annotated.
    "strict": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // hls.js's package.json `exports` has no "types" condition, so whether
      // an editor finds its typings depends on that TypeScript's fallback
      // lookup — some show `import('hls.js')` in red. Point at them directly.
      "hls.js": ["./node_modules/hls.js/dist/hls.d.ts"]
    },
    "types": ["bun"]
  },
  "include": ["src"]
}
